/* Carousel scroll now managed by React useEffect */
</script>

<script>
gsap.registerPlugin(ScrollTrigger);
(function(){
  var pct = 0;
  var bar = document.getElementById("loadingBar");
  var pctEl = document.getElementById("loadingPct");
  var overlay = document.getElementById("loadingOverlay");
  var int = setInterval(function(){
    pct += 0.5 + Math.random() * 3;
    if(pct >= 100){
      pct = 100; clearInterval(int);
      bar.style.width = "100%"; pctEl.textContent = "100%";
      overlay.style.opacity = "0";
      overlay.style.visibility = "hidden";
      // After a short delay, animate hero with GSAP
      setTimeout(function(){
        var mm = gsap.matchMedia();
        mm.add("(prefers-reduced-motion: no-preference)", function(){
          var tl = gsap.timeline({defaults:{ease:"power3.out"}});
          tl.fromTo(".hero-zoom", {scale:1.12}, {scale:1,duration:1.8,ease:"power2.out"}, 0);
          tl.fromTo(document.querySelectorAll(".hero-reveal"), {y:28,autoAlpha:0,filter:"blur(12px)"}, {y:0,autoAlpha:1,filter:"blur(0px)",duration:1.1,stagger:0.17}, 0.1);
          tl.fromTo(document.querySelectorAll(".hero-fade"), {y:20,autoAlpha:0}, {y:0,autoAlpha:1,duration:1,stagger:0.15}, 0.55);
          
        });
        mm.add("(prefers-reduced-motion: reduce)", function(){
          gsap.set([".hero-zoom",".hero-reveal",".hero-fade"], {clearProps:"all"});
        });
        // ScrollTrigger for section reveals
        gsap.fromTo("#ai-systems .gsap-reveal", {y:40,autoAlpha:0}, {y:0,autoAlpha:1,duration:0.8,ease:"power2.out",scrollTrigger:{trigger:"#ai-systems",start:"top 75%",toggleActions:"play none none reverse"}});
        gsap.fromTo("#ai-systems .gsap-card", {y:60,autoAlpha:0,scale:0.95}, {y:0,autoAlpha:1,scale:1,duration:0.7,stagger:0.1,ease:"power2.out",scrollTrigger:{trigger:"#ai-systems",start:"top 70%",toggleActions:"play none none reverse"}});
        gsap.fromTo("#design-works .gsap-reveal", {y:40,autoAlpha:0}, {y:0,autoAlpha:1,duration:0.8,ease:"power2.out",scrollTrigger:{trigger:"#design-works",start:"top 75%",toggleActions:"play none none reverse"}});
        gsap.fromTo("#methodology .gsap-reveal", {y:40,autoAlpha:0}, {y:0,autoAlpha:1,duration:0.8,ease:"power2.out",scrollTrigger:{trigger:"#methodology",start:"top 75%",toggleActions:"play none none reverse"}});
        gsap.fromTo("#methodology .gsap-card", {y:50,autoAlpha:0}, {y:0,autoAlpha:1,duration:0.7,stagger:0.1,ease:"power2.out",scrollTrigger:{trigger:"#methodology",start:"top 70%",toggleActions:"play none none reverse"}});
        gsap.fromTo("#about .gsap-reveal", {y:40,autoAlpha:0}, {y:0,autoAlpha:1,duration:0.8,ease:"power2.out",scrollTrigger:{trigger:"#about",start:"top 75%",toggleActions:"play none none reverse"}});
        gsap.fromTo("#about .skill-bar", {scaleX:0,transformOrigin:"left"}, {scaleX:1,duration:1.2,stagger:0.15,ease:"power2.out",scrollTrigger:{trigger:"#about",start:"top 70%",toggleActions:"play none none reverse"}});
        ScrollTrigger.refresh();
      }, 100);
      return;
    }
    bar.style.width = pct + "%";
    pctEl.textContent = Math.round(pct) + "%";
  }, 25);
})();
</script>

<script>
(function() {
  var img = document.getElementById("zoomTarget");
  var lens = document.getElementById("magLens");
  if (!img || !lens) return;
  img.addEventListener("mousemove", function(e) {
    var rect = this.getBoundingClientRect();
    var x = e.clientX - rect.left;
    var y = e.clientY - rect.top;
    if (x < 0 || y < 0 || x > rect.width || y > rect.height) { lens.style.display = "none"; return; }
    lens.style.display = "block";
    var size = 160, zoom = 3;
    var lx = Math.max(0, Math.min(x - size / 2, rect.width - size));
    var ly = Math.max(0, Math.min(y - size / 2, rect.height - size));
    lens.style.left = lx + "px";
    lens.style.top = ly + "px";
    lens.style.backgroundImage = "url(" + this.src + ")";
    lens.style.backgroundSize = (rect.width * zoom) + "px " + (rect.height * zoom) + "px";
    lens.style.backgroundPosition = (-x * zoom + size / 2) + "px " + (-y * zoom + size / 2) + "px";
    lens.style.borderColor = "rgba(255,255,255,0.35)";
  });
  img.addEventListener("mouseleave", function() { lens.style.display = "none"; });
})();
</script>





<script>function resizePoster() {
            const canvas = document.getElementById('poster-canvas');
            const targetWidth = 1920;
            const targetHeight = 1080;
            
            const windowWidth = window.innerWidth;
            const windowHeight = window.innerHeight;
            
            const scaleX = windowWidth / targetWidth;
            const scaleY = windowHeight / targetHeight;
            const scale = Math.min(scaleX, scaleY);
            
            canvas.style.transform = `translate(-50%, -50%) scale(${scale})`;
        }

        window.addEventListener('resize', resizePoster);
        window.addEventListener('DOMContentLoaded', resizePoster);</script>


<script>function resizePoster() {
            const canvas = document.getElementById('poster-canvas');
            const targetWidth = 1920;
            const targetHeight = 1080;
            
            const windowWidth = window.innerWidth;
            const windowHeight = window.innerHeight;
            
            const scaleX = windowWidth / targetWidth;
            const scaleY = windowHeight / targetHeight;
            const scale = Math.min(scaleX, scaleY);
            
            canvas.style.transform = `translate(-50%, -50%) scale(${scale})`;
        }

        window.addEventListener('resize', resizePoster);
        window.addEventListener('DOMContentLoaded', resizePoster);</script>
</body>
</html>
