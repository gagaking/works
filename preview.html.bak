<div id="loadingOverlay" style="position:fixed;inset:0;z-index:9999;background:#000;display:flex;flex-direction:column;align-items:center;justify-content:center;transition:opacity 0.6s ease,visibility 0.6s ease">
  <div style="display:flex;align-items:center;gap:12px;margin-bottom:32px">
    <svg width="40" height="40" viewBox="0 0 256 256" fill="#fff"><path d="M256 256H128L0 128h128Z"/><path d="M256 128H128L0 0h128Z"/></svg>
    <span style="color:#fff;font-size:28px;font-family:&quot;Playfair Display&quot;,serif;font-style:italic;letter-spacing:-0.03em">Lithos</span>
  </div>
  <div style="width:192px;height:2px;background:rgba(255,255,255,0.1);border-radius:999px;overflow:hidden">
    <div id="loadingBar" style="height:100%;background:#fff;width:0%;border-radius:999px"></div>
  </div>
  <span id="loadingPct" style="margin-top:12px;color:rgba(255,255,255,0.4);font-size:12px;font-family:monospace;letter-spacing:2px">0%</span>
</div>

