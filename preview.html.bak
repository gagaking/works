<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Lithos - Layers Hold Tales of Time</title>
<link  rel="stylesheet" />
<script src="libs/tailwind.js"></script>
<script>
tailwind.config = { theme: { extend: { fontFamily: { playfair: ['Playfair Display', 'serif'] } } } }
</script>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Inter','Noto Sans SC',sans-serif}
.font-playfair{font-family:'Playfair Display','Noto Serif SC',serif}
@keyframes heroReveal{0%{opacity:0;transform:translateY(28px);filter:blur(12px)}100%{opacity:1;transform:translateY(0);filter:blur(0)}}
@keyframes heroFadeUp{0%{opacity:0;transform:translateY(20px)}100%{opacity:1;transform:translateY(0)}}
@keyframes heroZoom{0%{transform:scale(1.12)}100%{transform:scale(1)}}
.hero-anim{opacity:0;animation-fill-mode:forwards;animation-timing-function:cubic-bezier(0.16,1,0.3,1)}
.hero-reveal{animation-name:heroReveal;animation-duration:1.1s}
.hero-fade{animation-name:heroFadeUp;animation-duration:1s}
.hero-zoom{animation:heroZoom 1.8s cubic-bezier(0.16,1,0.3,1) forwards}
@media(prefers-reduced-motion:reduce){.hero-anim,.hero-zoom{animation:none;opacity:1}}
.skill-bar{transition:width 1.2s cubic-bezier(0.16,1,0.3,1)}
.horizontal-scroll{display:flex;gap:1rem;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;-ms-overflow-style:none}
.horizontal-scroll > :first-child{width:360px!important}
.horizontal-scroll::-webkit-scrollbar{display:none}
.font-cn{font-family:'Noto Sans SC','Inter',sans-serif}.font-cn-serif{font-family:'Noto Serif SC','Playfair Display',serif}.horizontal-scroll>*{flex-shrink:0}

.hero-carousel{position:absolute;bottom:100px;left:5%;width:90%;height:225px;z-index:40;overflow:hidden;pointer-events:auto}
.hero-carousel-inner{display:flex;height:100%;overflow-x:auto;scrollbar-width:none;-ms-overflow-style:none}
.hero-carousel-inner::-webkit-scrollbar{display:none}
.hero-carousel-item{width:300px;height:225px;flex-shrink:0;overflow:hidden;position:relative;cursor:pointer;margin-right:8px}

.hero-carousel-item img{width:100%;height:100%;object-fit:cover}


.modal-overlay{position:fixed;inset:0;z-index:200;background:rgba(0,0,0,0.85);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;padding:24px;animation:fadeIn 0.3s ease}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.modal-content{display:flex;max-width:1200px;width:100%;max-height:85vh;overflow:hidden;background:#111;animation:modalSlideIn 0.35s cubic-bezier(0.16,1,0.3,1)}
@keyframes modalSlideIn{from{opacity:0;transform:scale(0.92) translateY(16px)}to{opacity:1;transform:scale(1) translateY(0)}}
.modal-image{width:50%;min-height:500px;background-size:cover;background-position:center}
.modal-text{width:50%;padding:40px 36px;display:flex;flex-direction:column;justify-content:center}
.modal-text .tag{display:inline-block;width:fit-content;font-size:10px;font-weight:600;letter-spacing:0.12em;color:rgba(255,255,255,0.5);background:rgba(255,255,255,0.08);padding:5px 12px;border-radius:999px;margin-bottom:16px;text-transform:uppercase}
.modal-text h2{color:#fff;font-size:28px;font-weight:600;letter-spacing:-0.02em;margin-bottom:10px}
.modal-text p{color:rgba(255,255,255,0.55);font-size:14px;line-height:1.7}
.modal-close{position:fixed;top:20px;right:24px;width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,0.08);border:none;color:#fff;font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background 0.2s;z-index:210}
.modal-close:hover{background:rgba(255,255,255,0.18)}
@media(max-width:640px){.modal-content{flex-direction:column}.modal-image{width:100%;min-height:280px}.modal-text{width:100%;padding:32px 28px}}

        /* Poster canvas styles */
/* 基础样式重置 */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        /* 锁死 1920x1080 实体沙箱 */
        #poster-canvas {
            width: 1920px;
            height: 1080px;
            background-color: #000000;
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            transform-origin: center center;
            color: #ffffff;
            font-family: "Helvetica Neue", Helvetica, Arial, "PingFang SC", sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        /* 占位图通用样式 */
        .image-placeholder {
            background-color: #141414;
            border: 1px dashed #333;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #444;
            font-size: 12px;
            position: absolute;
        }

        /* 统一大英文规格 */
        .title-en {
            font-size: 82px;
            font-weight: 900;
            letter-spacing: -2px;
            line-height: 0.9;
            position: absolute;
            white-space: nowrap;
        }

        /* 统一大中文规格 */
        .title-cn {
            font-size: 64px;
            font-weight: bold;
            line-height: 1;
            position: absolute;
            letter-spacing: 2px;
            white-space: nowrap;
        }

        /* 右上角蓝色空心小圈 */
        .title-cn::after {
            content: "°";
            color: #0055ff;
            font-size: 42px;
            font-weight: 300;
            position: absolute;
            top: -12px;
            right: -24px;
        }

        /* 统一小叙述字规格 */
        .desc-text {
            font-size: 11px;
            color: #888888;
            line-height: 1.6;
            position: absolute;
            width: 240px;
        }

        /* ==========================================================================
           【绝对物理坐标系】
           ========================================================================== */
        
        /* --- 轴线 1：最左侧对齐线 (left: 60px) --- */
        #img-athlete          { left: 60px;  top: 40px;  width: 350px; height: 490px; }
        #title-cooperation    { left: 60px;  top: 560px; }
        #desc-cooperation     { left: 60px;  top: 795px; }
        
        /* 【下移位置】：整体往下沉，完全贴近底部边缘 */
        #title-collaboration  { left: 60px;  top: 935px; font-size: 92px; } 

        /* --- 轴线 2：左区中段线 --- */
        #title-care           { left: 440px; top: 40px; }
        #title-efficiency     { left: 440px; top: 125px; }
        #desc-efficiency      { left: 440px; top: 430px; } 

        /* --- 轴线 3：左区右侧挂件线 --- */
        #img-boxing           { left: 720px; top: 40px;  width: 210px; height: 210px; }
        #img-trail-shoe       { left: 690px; top: 540px; width: 260px; height: 330px; }

        /* --- 轴线 4：【绿框区域左对齐大轴】 (left: 1130px) --- */
        #img-hanging-shoe     { left: 1130px; top: 180px; width: 430px; height: 240px; }
        #title-creativity     { left: 1130px; top: 450px; } 
        #title-creation-cn    { left: 1130px; top: 545px; } 
        #desc-creation        { left: 1130px; top: 625px; width: 250px; } 
        
        /* 【下移位置】：与左边的大英文齐平，彻底和上方的足球图错开空间 */
        #title-comfort        { left: 1130px; top: 935px; font-size: 92px; } 
        
        /* 足球图往上提，保持原本在中间偏下的区域 */
        #img-football         { left: 1130px; top: 760px; width: 250px; height: 135px; } 

        /* --- 轴线 5：最右侧靠边对齐线 (right: 60px) --- */
        #title-convenience    { right: 60px; top: 40px;  text-align: right; }
        #title-convenience-cn { right: 60px; top: 125px; text-align: right; }
        #desc-hanging-shoe    { right: 60px; top: 350px; text-align: right; width: 220px; }
        #title-intelligence   { right: 60px; top: 590px; text-align: right; } 
        
        /* 【下移位置】：右下角小字同步下移，底边缘看齐 */
        #desc-football        { right: 60px; top: 950px; text-align: right; width: 220px; }

