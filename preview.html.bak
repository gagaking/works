        </div>
      </section>

      <footer className="bg-[#0a0a0f] px-6 sm:px-10 md:px-16 lg:px-20 py-12 sm:py-16">
        <div className="max-w-[1400px] mx-auto flex flex-col sm:flex-row items-center justify-between gap-6">
          <p className="text-white text-xl sm:text-2xl font-light">
            {home.footerTagline1} <span className="text-indigo-400 font-medium">{home.footerTaglineHighlight}</span>{home.footerTagline2}
          </p>
          <div className="flex items-center gap-6">
            <span className="text-white/40 text-xs">{home.footerCopyright}</span>
            <span className="text-white/20 text-xs ml-4">v1.0.0</span>
            <button className="flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white text-sm font-medium px-6 py-2.5 transition-colors">
              {home.footerButtonText}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </button>
          </div>
        </div>
      </footer>

            
      {modalItem && (
        <div className="modal-overlay" onClick={closeModal}>
          <button className="modal-close" onClick={closeModal}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M18 6L6 18"/><path d="M6 6l12 12"/></svg>
          </button>
          <div className="modal-content" onClick={(e) => e.stopPropagation()}>
            <div className="modal-image" style={{background: modalItem.gradient + ", url(https://picsum.photos/seed/" + modalItem.title.toLowerCase().replace(/\s+/g, "") + "/600/500), #222"}} />
            <div className="modal-text">
              <span className="tag">{modalItem.tag}</span>
              <h2>{modalItem.title}</h2>
              <p>{modalItem.desc}</p>
            </div>
          </div>
        </div>
      )}

    </div>
  );
}

ReactDOM.createRoot(document.getElementById("root")).render(<App />);
</script>

<script>
(function() {
  var _el = null, _paused = false, _speed = 0.8;
  function init() {
    _el = document.getElementById("heroCarousel");
    if (!_el || !_el.children || _el.children.length === 0) { setTimeout(init, 300); return; }
    // Clone items for seamless infinite loop (all 300px base)
    if (!_el.dataset.cloned) {
      var cnt = _el.children.length;
      for (var i = 0; i < cnt; i++) {
        _el.appendChild(_el.children[i].cloneNode(true));
      }
      _el.dataset.cloned = "1";
    }
    // All items stay at 300px (CSS default)
    _el.addEventListener("mouseenter", function() { _paused = true; });
    _el.addEventListener("mouseleave", function() { _paused = false; });
        // GSAP breakthrough hover effect
    Array.from(_el.children).forEach(function(item) {
      item.style.transformOrigin = "center center";
      item.addEventListener("mouseenter", function() {
        // Break out of container bounds and overlap neighbors
        this.style.overflow = "visible";
        this.style.zIndex = "10";
        var carousel = document.querySelector(".hero-carousel");
        var inner = document.getElementById("heroCarousel");
        if (carousel) carousel.style.overflow = "visible";
        if (inner) inner.style.overflow = "visible";
        // Light burst overlay
        var overlay = document.createElement("div");
        overlay.style.cssText = "position:absolute;inset:0;background:radial-gradient(circle at center, rgba(255,255,255,0.35) 0%, transparent 70%);z-index:5;pointer-events:none;opacity:0;border-radius:inherit;";
        this.appendChild(overlay);
        var img = this.querySelector("img");
        var labelSpan = this.querySelector(".label span");
        var tl = gsap.timeline({ defaults: { ease: "power2.out" }, onComplete: function() { if (overlay.parentNode) overlay.remove(); } });
        // Larger scale to break out - overlaps adjacent items
        tl.to(this, { scale: 1.4, duration: 0.5, ease: "back.out(2.5)" }, 0);
        tl.to(overlay, { opacity: 0.7, duration: 0.1 }, 0);
        tl.to(overlay, { opacity: 0, duration: 0.35 }, 0.1);
        if (img) tl.to(img, { scale: 1.08, duration: 0.55 }, 0.05);
        if (labelSpan) {
          gsap.set(labelSpan, { y: 24, opacity: 0, filter: "blur(6px)", willChange: "transform, opacity, filter" });
          tl.to(labelSpan, { y: 0, opacity: 1, filter: "blur(0px)", duration: 0.4 }, 0.15);
        }
        // Outer glow shadow for depth
        tl.to(this, { boxShadow: "0 20px 60px rgba(0,0,0,0.5), 0 0 40px rgba(96,165,250,0.3)", duration: 0.3 }, 0);
      });
      item.addEventListener("mouseleave", function() {
        this.style.overflow = "";
        this.style.zIndex = "";
        var carousel = document.querySelector(".hero-carousel");
        var inner = document.getElementById("heroCarousel");
        if (carousel) carousel.style.overflow = "";
        if (inner) inner.style.overflow = "";
        gsap.to(this, { scale: 1, duration: 0.4, ease: "power2.inOut", boxShadow: "0 0 0 rgba(0,0,0,0)" });
        var img = this.querySelector("img");
        if (img) gsap.to(img, { scale: 1, duration: 0.4 });
        var labelSpan = this.querySelector(".label span");
        if (labelSpan) {
          gsap.set(labelSpan, { clearProps: "y,opacity,filter,willChange" });
        }
      });
      // Also reset parent overflow when non-hovered
    });
    // Click to view large image
    Array.from(_el.children).forEach(function(item) {
      item.addEventListener("click", function(e) {
        var imgEl = this.querySelector("img");
        if (!imgEl) return;
        var src = imgEl.getAttribute("src");
        var label = this.querySelector(".label span");
        var text = label ? label.textContent : "";
        // Create image lightbox overlay
        var ov = document.createElement("div");
        ov.style.cssText = "position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.92);display:flex;align-items:center;justify-content:center;cursor:pointer;animation:fadeIn 0.25s ease";
        var ci = document.createElement("img");
        ci.src = src;
        ci.style.cssText = "max-width:85vw;max-height:80vh;object-fit:contain;box-shadow:0 30px 80px rgba(0,0,0,0.5);border-radius:0";
        ov.appendChild(ci);
        if (text) {
          var lb = document.createElement("div");
          lb.textContent = text;
          lb.style.cssText = "position:absolute;bottom:30px;left:50%;transform:translateX(-50%);color:rgba(255,255,255,0.6);font-size:12px;letter-spacing:0.1em;font-weight:500";
          ov.appendChild(lb);
        }
        var cb = document.createElement("button");
        cb.innerHTML = "&times;";
        cb.style.cssText = "position:fixed;top:24px;right:28px;width:38px;height:38px;background:rgba(255,255,255,0.08);border:none;color:#fff;font-size:22px;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:10000;border-radius:0";
        ov.appendChild(cb);
        var closeFn = function() { ov.remove(); };
        ov.onclick = closeFn;
        cb.onclick = function(ev) { ev.stopPropagation(); ov.remove(); };
        document.body.appendChild(ov);
      });
    });

    setInterval(tick, 20);
  }
  function tick() {
    if (!_el || _paused) return;
    var hw = _el.scrollWidth - _el.clientWidth;
    if (hw <= 0) return;
    var half = hw / 2;
    if (_el.scrollLeft >= half) { _el.scrollLeft = 0; }
    else { _el.scrollLeft += _speed; }
    // Update progress bar
    var bar = document.getElementById("designWorksBar");
    if (bar) { bar.style.width = ((_el.scrollLeft / hw) * 100) + "%"; }
  }
  if (document.readyState === "complete") { init(); }
  else { window.addEventListener("load", init); }
})()
</script>


<script>
(function() {
  var _el = null;
  var _paused = false;
  var _speed = 0.8;
  function init() {
    _el = document.querySelector('.horizontal-scroll');
    if (!_el) { setTimeout(init, 500); return; }
    // Clone items for seamless loop
    var count = _el.children.length;
    for (var i = 0; i < count; i++) {
      var _node = _el.children[i].cloneNode(true);
      if (i === 0) _node.style.width = '360px';
      _el.appendChild(_node);
    }
    _el.addEventListener('mouseenter', function() { _paused = true; });
    _el.addEventListener('mouseleave', function() { _paused = false; });
    setInterval(tick, 20);
  }
  function tick() {
    if (!_el || _paused) return;
    var hw = _el.scrollWidth - _el.clientWidth;
    if (hw <= 0) return;
    var half = hw / 2;
    if (_el.scrollLeft >= half) {
      _el.scrollLeft = 0;
    } else {
      _el.scrollLeft += _speed;
    }
    var bar = document.getElementById("designWorksBar");
    if (bar) { bar.style.width = ((_el.scrollLeft / hw) * 100) + "%"; }
  }
  if (document.readyState === 'complete') { init(); }
  else { window.addEventListener('load', init); }
})();
</script>

