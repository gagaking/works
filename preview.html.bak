var _d={aiWorks:[{tag:"AI + VISUAL",title:"PROMPT STUDIO",desc:"AI-powered prompt testing environment.",gradient:"linear-gradient(to bottom right,#3730a3,#4f46e5,#60a5fa)"},{tag:"AI + SYSTEM",title:"AUTO PIPELINE",desc:"End-to-end automated content generation system.",gradient:"linear-gradient(to bottom right,#5b21b6,#9333ea,#e879f9)"},{tag:"AI + BRAND",title:"NEURAL CANVAS",desc:"AI-assisted brand asset generation platform.",gradient:"linear-gradient(to bottom right,#1e293b,#4338ca,#a855f7)"},{tag:"AI + DATA",title:"VISION LAB",desc:"Visual data analysis powered by AI models.",gradient:"linear-gradient(to bottom right,#1e3a5f,#2563eb,#22d3ee)"}],works:[{tag:"AI + VISUAL",title:"ECHO GENERATIVE",desc:"AI-driven visual system for generative art exploration.",gradient:"linear-gradient(to bottom right,#581c87,#7e22ce,#a855f7)"},{tag:"BRAND + WEB",title:"NEXUS STUDIO",desc:"Digital identity and website design for a creative agency.",gradient:"linear-gradient(to bottom right,#1e293b,#475569,#94a3b8)"},{tag:"AI + PRODUCT",title:"FLOW AI",desc:"AI productivity platform with intelligent automation.",gradient:"linear-gradient(to bottom right,#1e1b4b,#5b21b6,#9333ea)"},{tag:"MOTION + 3D",title:"BEYOND REALMS",desc:"Immersive motion story told through 3D and sound.",gradient:"linear-gradient(to bottom right,#86198f,#c026d3,#f472b6)"},{tag:"WEB + UX",title:"PRISM DESIGN",desc:"Modern design system for cross-platform applications.",gradient:"linear-gradient(to bottom right,#115e59,#059669,#4ade80)"},{tag:"BRAND + IDENTITY",title:"AURORA BRAND",desc:"Complete visual identity for a tech startup.",gradient:"linear-gradient(to bottom right,#9f1239,#db2777,#fb923c)"}],methodologyCards:[{title:"Prompt = Structured Control Language",subtitle:"\u63d0\u793a\u8bcd\u662f\u7ed3\u6784\u5316\u7684\u63a7\u5236\u8bed\u8a00",desc:"\u628a\u6a21\u7cca\u60f3\u6cd5\u8f6c\u5316\u4e3a\u7cbe\u51c6\u7684\u89c6\u89c9\u6307\u4ee4\uff0c\u53ef\u590d\u7528\u3001\u53ef\u63a7\u7684\u89c6\u89c9\u8f93\u51fa\u300